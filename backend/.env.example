DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=thermo_iot

JWT_SECRET=

DEVICE_API_KEY=

# Opcional. Lista de orígenes permitidos por CORS, separados por
# comas (ej. https://miapp.com,https://www.miapp.com). Si la dejas
# vacía, se refleja el origen de cada petición — necesario para el
# uso normal del proyecto (acceso por IP local, celular, túneles de
# demo). Solo tiene sentido fijarla en un despliegue de producción
# con dominio fijo.
CORS_ORIGIN=

# Días que se conservan las mediciones y eventos antes de purgarse
# automáticamente. Opcionales — si no se ponen, usa 30 y 90 por defecto.
RETENCION_DIAS_MEDICIONES=30
RETENCION_DIAS_EVENTOS=90

PORT=3000
