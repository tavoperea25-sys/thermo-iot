# Copia este archivo como ".env" (en esta misma carpeta, junto a
# docker-compose.yml) y completa tus propios valores.
# Este .env es SOLO para Docker Compose — no se mezcla con
# backend/.env ni backend/.env.test, que siguen usándose para
# correr el proyecto sin Docker o correr las pruebas.

MYSQL_ROOT_PASSWORD=cambia-esto-por-una-contraseña-segura

JWT_SECRET=cambia-esto-tambien

DEVICE_API_KEY=genera-una-llave-larga-y-unica
